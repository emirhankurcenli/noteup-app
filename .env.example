# ─────────────────────────────────────────────────────────
# NoteUp — Ortam Değişkenleri Şablonu (.env.example)
# ─────────────────────────────────────────────────────────
# Bu dosyayı kopyalayıp .env olarak adlandırın,
# sonra gerçek değerleri girin.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# RevenueCat Public API Key (Google Play satın alımlar için)
VITE_REVENUECAT_KEY=goog_your_revenuecat_key_here

# Supabase Proje URL ve Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOT: R2_WORKER_URL ve R2_BEARER_TOKEN artık Supabase Secret olarak saklanmaktadır.

